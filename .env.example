APP_NAME="My App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=my_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# SSO — ontwerp: elke site is een autonome login-app.
# Zet IS_LOGIN_APP=true en laat LOGIN_URL leeg, zodat je op DEZE site zelf kunt inloggen
# (niet redirecten naar een andere app). Users moeten met dezelfde sso_id in de users-tabel staan.
SSO_SECRET=
SSO_COOKIE_DOMAIN=.localhost
SSO_IS_LOGIN_APP=true
SSO_LOGIN_URL=
AUTH_MAGIC_LINK_ENABLED=true
AUTH_TOKEN_EXPIRY_MINUTES=30

AI_STUDIO_URL=https://ai-studio.phitech.cloud/api
AI_STUDIO_API_KEY=
AI_STUDIO_CHAT_MODE=prompt
AI_STUDIO_CHAT_SLUG=my-app

UI_PRIMARY="#5b6abf"
UI_PRIMARY_DARK="#4a579e"
UI_ACCENT=
UI_BG=
